# Pixxel MASKING service — deployed as its OWN Hugging Face Space, separate from
# the erase/inpaint service (services/segment). The Next.js app points at it via
# MASKING_SERVICE_URL. Copy to .env (or export in your shell).

# ── SAM 3.1 — primary subject / instance / text-grounding engine ──────────────
# Gated checkpoint: the account running this must be approved at
# https://huggingface.co/facebook/sam3.1 and logged in (`hf auth login`).
# macOS/CPU: main.py installs a Triton stub automatically and runs on CPU.
SAM3_ENABLE=1
SAM3_MODEL_ID=facebook/sam3.1
# Preload at startup (1) vs lazily on first request (0). 1 downloads ~3.5 GB.
SAM3_EAGER=0
SAM3_CONFIDENCE=0.5
SAM3_SUBJECT_PROMPT=main subject
SAM3_INSTANCES_MAX=24
# Hair-level matting refinement (adds CPU latency). METHOD: pymatting_cf |
# pymatting_knn | guided (cv2 fallback).
SAM3_REFINE_MATTING=0
SAM3_REFINE_METHOD=pymatting_cf
SAM3_REFINE_MAX_SIDE=1024
SAM3_REFINE_ERODE=6
SAM3_REFINE_DILATE=18
# SAM3_CHECKPOINT_PATH=/abs/path/to/sam3.1_multiplex.pt   # optional local ckpt

# ── /segment saliency fallback (rembg) — used when SAM 3 is off/unavailable ───
# birefnet-general (~973 MB) = most complete matte; birefnet-general-lite
# (~215 MB) = smaller/faster; isnet-general-use (~168 MB) = tiny fallback.
SEGMENT_MODEL=birefnet-general
SEGMENT_MAX_SIDE=2048
# Load torch models (SAM 2 + Depth) lazily on first use (0) vs at startup (1).
SEGMENT_EAGER_MODELS=0

# ── Matte cleanup tuning ──────────────────────────────────────────────────────
MATTE_HOLE_FILL_MAX_FRAC=0.02
MATTE_FAINT_RECOVER_MAX=96
MATTE_FAINT_MIN_SOLID_FRAC=0.50

# ── SAM 2 click/box (/sam2/click) ─────────────────────────────────────────────
SAM2_MODEL_ID=facebook/sam2-hiera-small
SAM2_CACHE_MAX=20
SAM2_MAX_CLICKS=50

# ── Depth Anything V2 (/depth) ────────────────────────────────────────────────
DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Small-hf
DEPTH_CACHE_MAX=20
DEPTH_CACHE_MAX_PIXELS=4194304
DEPTH_MAX_SIDE=2048

# ── CLIPSeg text-grounding fallback (/ground/text) ────────────────────────────
GROUND_MODEL_ID=CIDAS/clipseg-rd64-refined

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8002
MAX_UPLOAD_MB=24
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Model cache (avoid re-downloading on restart) ─────────────────────────────
# HF Spaces with Persistent Storage mounts at /data:
#   MODEL_CACHE_DIR=/data/models
# MODEL_CACHE_DIR=/data/models
